<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store 提出用 IPA の書き出し設定 (xcodebuild -exportArchive -exportOptionsPlist)。

  teamID は OmniVerse / ココメシと同じ Apple Developer アカウント。
  provisioningProfiles のキーは Bundle ID、値は Developer ポータルで作った
  プロビジョニングプロファイル名。プロファイルを作るときに名前を変えたら、
  ここと .github/workflows/build.yml の PROVISIONING_PROFILE_SPECIFIER も合わせること。

  signingStyle = manual なので、CI では証明書 (.p12) とプロファイル (.mobileprovision)
  をキーチェーンに入れる手順が要る (build.yml の ios-appstore ジョブ)。
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>M5D5CQRGX8</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.rou39.vloom</key>
		<string>Vloom AppStore</string>
	</dict>
	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
