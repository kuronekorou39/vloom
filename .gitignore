# Phase 0 サンプル/スクラッチ出力
samples/
scratch/

# web 開発サーバ (serve_https.py) の実行時生成物
# certs: 自己署名証明書 + 秘密鍵 (起動時に自動生成)
# client_logs: /capture・/log の保存先 (実機キャプチャ PNG・ログ)
certs/
client_logs/

# 作業環境の写真・生成画像 (コミット不要)
PXL_*.jpg
Gemini_Generated_Image_*.png

# PC PWA の WASM (CI で wasm-pack ビルド)
web/pwa/pkg/

# Android リリース署名 (鍵と資格情報。CI では Secrets から生成する)
key.properties
*.jks
*.keystore

# Pages デプロイ時に web/pwa へコピーされる表記 (正本はリポジトリ直下)
web/pwa/THIRD-PARTY-NOTICES.md
web/pwa/licenses/
